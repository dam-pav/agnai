# Portainer (Docker Standalone): complete this file, then use
# Stacks > Add stack > Environment variables > Load variables from .env file.
# Compose CLI: copy this file to .env beside docker-compose.advanced.yml.
# Paths are on the Docker host; mount the network share there first.
# All six persistent directories, including MongoDB, default to this share.
DATA_ROOT=/mnt/agnai

# Numeric owner of the application's directories on the storage server.
PUID=1000
PGID=1000
# MongoDB may use a different owner. Set these to your share's UID/GID if needed.
MONGO_UID=999
MONGO_GID=999

# Leave these unset to use DATA_ROOT/dbdata and DATA_ROOT/dbconfig on the share.
# Optional overrides for a different layout on the same network resource:
# MONGO_DATA_PATH=/mnt/agnai/mongo/data
# MONGO_CONFIG_PATH=/mnt/agnai/mongo/config

AGNAI_IMAGE=ghcr.io/dam-pav/agnaistic:latest
MONGO_IMAGE=mongo:8
REDIS_IMAGE=redis:7
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=3001
DB_NAME=agnai
INITIAL_USER=admin
# Required: replace these empty values before starting.
INITIAL_PASSWORD=
# Keep this value across container recreation. Generate with: openssl rand -hex 32
JWT_SECRET=
LOG_LEVEL=info
