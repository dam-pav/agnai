{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "definitions": {
    "ScenarioEventTrigger": {
      "anyOf": [
        { "$ref": "#/definitions/ScenarioEventGreetingTrigger" },
        { "$ref": "#/definitions/ScenarioEventManualTrigger" },
        { "$ref": "#/definitions/ScenarioEventOnConnectTrigger" }
      ]
    },
    "ScenarioEventGreetingTrigger": {
      "type": "object",
      "properties": {
        "kind": { "const": "greeting" }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "ScenarioEventManualTrigger": {
      "type": "object",
      "properties": {
        "kind": { "const": "manual" },
        "probability": { "type": "number" }
      },
      "required": ["kind", "probability"],
      "additionalProperties": false
    },
    "ScenarioEventOnConnectTrigger": {
      "type": "object",
      "properties": {
        "kind": { "const": "connect" },
        "after": { "type": "number" }
      },
      "required": ["kind", "after"],
      "additionalProperties": false
    },
    "ScenarioEvent": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "string" } },
        "assigns": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "trigger": { "$ref": "#/definitions/ScenarioEventTrigger" }
      },
      "required": ["name", "requires", "assigns", "type", "text", "trigger"],
      "additionalProperties": false
    },
    "VariableBand": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "text": { "type": "string" }
      },
      "required": ["id", "min", "max", "text"]
    },
    "VariableModifier": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "delta": { "type": "number" }
      },
      "required": ["id", "name", "condition", "delta"]
    },
    "VariableDefinition": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "precision": { "type": "integer", "minimum": 0, "maximum": 6 },
        "revision": { "type": "integer", "minimum": 1 },
        "bands": { "type": "array", "items": { "$ref": "#/definitions/VariableBand" } },
        "modifiers": { "type": "array", "items": { "$ref": "#/definitions/VariableModifier" } }
      },
      "required": ["name", "min", "max", "precision", "revision", "bands", "modifiers"]
    },
    "VariableInstance": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "name": { "type": "string" },
        "initial": { "type": "number" },
        "classSnapshot": { "$ref": "#/definitions/VariableDefinition" },
        "bands": { "type": "array", "items": { "$ref": "#/definitions/VariableBand" } },
        "modifiers": { "type": "array", "items": { "$ref": "#/definitions/VariableModifier" } }
      },
      "required": ["id", "classId", "name", "initial", "classSnapshot"]
    },
    "ScenarioBook": {
      "type": "object",
      "properties": {
        "kind": { "const": "scenario" },
        "_id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "text": { "type": "string" },
        "overwriteCharacterScenario": { "type": "boolean" },
        "scanForMemory": { "type": "boolean", "default": false },
        "memoryBookIds": { "type": "array", "items": { "type": "string" } },
        "defaultCharacterIds": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "array", "items": { "$ref": "#/definitions/VariableInstance" } },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/definitions/ScenarioEvent" }
        }
      },
      "required": [
        "kind",
        "_id",
        "userId",
        "name",
        "description",
        "text",
        "overwriteCharacterScenario",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/ScenarioBook"
}
